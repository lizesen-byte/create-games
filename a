<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TRANSFORMERS: LEGACY WARS</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

        body {
            background: #0a0a0f;
            font-family: 'Orbitron', monospace;
            overflow: hidden;
            height: 100vh;
            color: #fff;
        }

        #gameCanvas {
            display: block;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(ellipse at center, #14141f 0%, #050508 100%);
            cursor: crosshair;
        }

        #hud {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        #topBar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 18px 28px;
            background: linear-gradient(180deg, rgba(0, 0, 0, 0.85) 0%, transparent 100%);
            border-bottom: 1px solid rgba(0, 180, 255, 0.15);
        }

        #factionDisplay {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        #factionIcon {
            font-size: 28px;
            text-shadow: 0 0 20px rgba(0, 150, 255, 0.6);
        }

        #factionName {
            font-size: 14px;
            letter-spacing: 3px;
            color: #8af;
            text-shadow: 0 0 10px rgba(0, 150, 255, 0.3);
        }

        #sparkDisplay {
            text-align: right;
        }

        #sparkLabel {
            font-size: 9px;
            color: #667;
            letter-spacing: 2px;
        }

        #sparkValue {
            font-size: 22px;
            font-weight: 900;
            color: #ffcc44;
            text-shadow: 0 0 30px rgba(255, 200, 50, 0.3);
        }

        #modeIndicator {
            position: absolute;
            bottom: 120px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid rgba(0, 180, 255, 0.2);
            padding: 12px 32px;
            border-radius: 4px;
            backdrop-filter: blur(8px);
            text-align: center;
            transition: all 0.3s ease;
            pointer-events: auto;
        }

        #modeLabel {
            font-size: 11px;
            color: #889;
            letter-spacing: 4px;
        }

        #modeName {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 6px;
            transition: color 0.3s;
        }

        #modeName.robot {
            color: #4cf;
            text-shadow: 0 0 30px rgba(60, 200, 255, 0.4);
        }
        #modeName.vehicle {
            color: #f84;
            text-shadow: 0 0 30px rgba(255, 120, 50, 0.4);
        }

        #modePrompt {
            font-size: 10px;
            color: #556;
            margin-top: 4px;
            letter-spacing: 1px;
        }

        #combinerContainer {
            position: absolute;
            bottom: 40px;
            right: 40px;
            width: 160px;
        }

        #combinerLabel {
            font-size: 9px;
            color: #667;
            letter-spacing: 3px;
            text-align: right;
            margin-bottom: 4px;
        }

        #combinerBar {
            width: 100%;
            height: 6px;
            background: #1a1a2a;
            border-radius: 3px;
            overflow: hidden;
            border: 1px solid #2a2a3a;
        }

        #combinerFill {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #ff4444, #ff8800, #ffcc00);
            border-radius: 3px;
            transition: width 0.2s;
            box-shadow: 0 0 20px rgba(255, 100, 0, 0.3);
        }

        #combinerStatus {
            font-size: 8px;
            color: #889;
            text-align: right;
            margin-top: 3px;
            letter-spacing: 2px;
        }

        #statusMessage {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 48px;
            font-weight: 900;
            letter-spacing: 8px;
            opacity: 0;
            transition: all 0.5s ease;
            text-shadow: 0 0 60px rgba(255, 200, 0, 0.2);
            pointer-events: none;
        }

        #statusMessage.show {
            opacity: 1;
            transform: translate(-50%, -60%);
        }

        #scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 20;
            background: repeating-linear-gradient(0deg,
                    transparent,
                    transparent 2px,
                    rgba(0, 0, 0, 0.03) 2px,
                    rgba(0, 0, 0, 0.03) 4px);
        }

        #vignette {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
            background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.6) 100%);
        }

        #controlsHelp {
            position: absolute;
            bottom: 40px;
            left: 40px;
            font-size: 10px;
            color: #445;
            letter-spacing: 1px;
            line-height: 1.8;
        }

        #controlsHelp span {
            color: #8af;
            background: rgba(0, 150, 255, 0.08);
            padding: 2px 10px;
            border: 1px solid rgba(0, 150, 255, 0.1);
            border-radius: 2px;
            font-weight: 700;
        }

        #scoreDisplay {
            position: absolute;
            top: 80px;
            right: 28px;
            text-align: right;
            font-size: 12px;
            color: #667;
            letter-spacing: 2px;
        }

        #scoreDisplay span {
            display: block;
            font-size: 28px;
            color: #fff;
            font-weight: 900;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
        }

        @media (max-width: 768px) {
            #topBar {
                padding: 12px 16px;
                flex-direction: column;
                gap: 6px;
            }
            #factionName {
                font-size: 10px;
            }
            #sparkValue {
                font-size: 16px;
            }
            #modeIndicator {
                bottom: 100px;
                padding: 8px 18px;
            }
            #modeName {
                font-size: 18px;
            }
            #combinerContainer {
                bottom: 20px;
                right: 20px;
                width: 120px;
            }
            #controlsHelp {
                display: none;
            }
            #statusMessage {
                font-size: 28px;
            }
            #scoreDisplay {
                top: 100px;
                right: 16px;
            }
            #scoreDisplay span {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>

    <div id="hud">
        <div id="topBar">
            <div id="factionDisplay">
                <div id="factionIcon">⚡</div>
                <div>
                    <div id="factionName">AUTOBOT · LEGACY</div>
                    <div style="font-size:9px;color:#445;letter-spacing:1px;">CYBERTRONIAN</div>
                </div>
            </div>
            <div id="sparkDisplay">
                <div id="sparkLabel">⚡ SPARK ENERGY</div>
                <div id="sparkValue">100%</div>
            </div>
        </div>

        <div id="scoreDisplay">
            SCORE
            <span id="scoreValue">0</span>
        </div>

        <div id="modeIndicator">
            <div id="modeLabel">▼ MORPH STATE ▼</div>
            <div id="modeName" class="robot">ROBOT</div>
            <div id="modePrompt">[ SPACE ] to Morph · [ CLICK ] to Attack</div>
        </div>

        <div id="combinerContainer">
            <div id="combinerLabel">◈ COMBINER CHARGE</div>
            <div id="combinerBar"><div id="combinerFill"></div></div>
            <div id="combinerStatus">0% · INACTIVE</div>
        </div>

        <div id="statusMessage">⚡ MORPH</div>

        <div id="controlsHelp">
            <span>SPACE</span> Morph &nbsp;|&nbsp; <span>CLICK</span> Attack &nbsp;|&nbsp; <span>R</span> Reset
        </div>
    </div>

    <div id="scanlines"></div>
    <div id="vignette"></div>

    <script>
        // ============================================================
        //  TRANSFORMERS: LEGACY WARS — COMPLETE PROTOTYPE
        // ============================================================

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        const modeNameEl = document.getElementById('modeName');
        const modePromptEl = document.getElementById('modePrompt');
        const sparkValueEl = document.getElementById('sparkValue');
        const combinerFill = document.getElementById('combinerFill');
        const combinerStatus = document.getElementById('combinerStatus');
        const statusMsg = document.getElementById('statusMessage');
        const scoreValueEl = document.getElementById('scoreValue');

        let W, H;

        function resize() {
            W = canvas.width = window.innerWidth;
            H = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        // ============================================================
        //  GAME STATE
        // ============================================================
        const state = {
            mode: 'robot',
            spark: 100,
            maxSpark: 100,
            combinerCharge: 0,
            maxCombiner: 100,
            isCombinerReady: false,
            score: 0,
            enemies: [],
            buildings: [],
            particles: [],
            projectiles: [],
            player: {
                x: W / 2,
                y: H / 2,
                radius: 28,
                targetX: W / 2,
                targetY: H / 2,
                speed: 4,
                angle: 0,
                glow: 0,
            },
            shake: 0,
            comboCount: 0,
            comboTimer: 0,
            morphCooldown: 0,
            attackCooldown: 0,
            gameTime: 0,
            enemySpawnTimer: 60,
            destroyedBuildings: 0,
        };

        // ============================================================
        //  BUILDINGS
        // ============================================================
        function spawnBuildings() {
            state.buildings = [];
            const cols = 8;
            const rows = 5;
            const spacingX = W / (cols + 1);
            const spacingY = H / (rows + 2);
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const x = spacingX * (c + 1) + (Math.random() - 0.5) * 60;
                    const y = spacingY * (r + 1) + (Math.random() - 0.5) * 40;
                    const w = 30 + Math.random() * 50;
                    const h = 40 + Math.random() * 80;
                    const hp = 2 + Math.floor(Math.random() * 3);
                    state.buildings.push({
                        x,
                        y,
                        w,
                        h,
                        hp,
                        maxHp: hp,
                        color: `hsl(${200 + Math.random() * 40}, 30%, ${20 + Math.random() * 25}%)`,
                        destroyed: false,
                    });
                }
            }
        }
        spawnBuildings();

        // ============================================================
        //  ENEMIES
        // ============================================================
        function spawnEnemy() {
            const side = Math.floor(Math.random() * 4);
            let x, y;
            const pad = 60;
            if (side === 0) { x = -pad;
                y = Math.random() * H; } else if (side === 1) { x = W + pad;
                y = Math.random() * H; } else if (side === 2) { x = Math.random() * W;
                y = -pad; } else { x = Math.random() * W;
                y = H + pad; }

            const types = ['scout', 'soldier', 'tank'];
            const type = types[Math.floor(Math.random() * types.length)];
            const hp = type === 'scout' ? 20 : type === 'soldier' ? 40 : 70;
            const speed = type === 'scout' ? 1.8 : type === 'soldier' ? 1.2 : 0.7;
            const radius = type === 'scout' ? 18 : type === 'soldier' ? 24 : 32;

            state.enemies.push({
                x,
                y,
                radius,
                hp,
                maxHp: hp,
                type,
                speed,
                angle: 0,
                hitTimer: 0,
                attackCooldown: 0,
                color: type === 'scout' ? '#ff4466' : type === 'soldier' ? '#ff8844' : '#cc2244',
            });
        }

        // ============================================================
        //  PARTICLES
        // ============================================================
        function emitParticles(x, y, count, color, speed = 5, life = 40) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const spd = Math.random() * speed + 1;
                state.particles.push({
                    x,
                    y,
                    vx: Math.cos(angle) * spd,
                    vy: Math.sin(angle) * spd,
                    life: life * (0.5 + Math.random() * 0.5),
                    maxLife: life,
                    radius: 2 + Math.random() * 4,
                    color: color,
                });
            }
        }

        function emitExplosion(x, y, size = 1) {
            const colors = ['#ff8844', '#ffcc44', '#ff4400', '#ffaa66', '#ffffff'];
            for (let i = 0; i < 40 * size; i++) {
                const c = colors[Math.floor(Math.random() * colors.length)];
                emitParticles(x, y, 1, c, 8 * size, 30 * size);
            }
            state.shake = 8 * size;
        }

        // ============================================================
        //  PROJECTILES
        // ============================================================
        function fireProjectile(targetX, targetY) {
            if (state.attackCooldown > 0) return;
            const p = state.player;
            const dx = targetX - p.x;
            const dy = targetY - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 10) return;

            const speed = 12;
            const vx = (dx / dist) * speed;
            const vy = (dy / dist) * speed;

            state.projectiles.push({
                x: p.x,
                y: p.y,
                vx,
                vy,
                radius: 6,
                life: 80,
                damage: state.mode === 'robot' ? 15 : 25,
                trail: [],
            });

            state.attackCooldown = state.mode === 'robot' ? 12 : 20;
            emitParticles(p.x, p.y, 8, '#4cf', 3, 15);
        }

        // ============================================================
        //  UPDATE
        // ============================================================
        function update() {
            state.gameTime++;

            const p = state.player;
            const dx = p.targetX - p.x;
            const dy = p.targetY - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist > 2) {
                const moveSpeed = Math.min(state.mode === 'vehicle' ? p.speed * 2.2 : p.speed, dist);
                p.x += (dx / dist) * moveSpeed;
                p.y += (dy / dist) * moveSpeed;
                p.angle = Math.atan2(dy, dx);
            }

            p.x = Math.max(p.radius, Math.min(W - p.radius, p.x));
            p.y = Math.max(p.radius, Math.min(H - p.radius, p.y));

            p.glow = 0.5 + 0.5 * Math.sin(state.gameTime * 0.04);

            if (state.attackCooldown > 0) state.attackCooldown--;
            if (state.morphCooldown > 0) state.morphCooldown--;
            if (state.comboTimer > 0) state.comboTimer--;
            else state.comboCount = 0;

            if (state.spark < state.maxSpark) {
                state.spark += 0.04;
                if (state.spark > state.maxSpark) state.spark = state.maxSpark;
            }

            if (state.combinerCharge < state.maxCombiner) {
                state.combinerCharge += 0.06;
                if (state.combinerCharge >= state.maxCombiner) {
                    state.combinerCharge = state.maxCombiner;
                    state.isCombinerReady = true;
                    showStatus('⚡ COMBINER READY');
                }
            }

            state.enemySpawnTimer--;
            if (state.enemySpawnTimer <= 0 && state.enemies.length < 12) {
                spawnEnemy();
                state.enemySpawnTimer = 60 + Math.random() * 80;
            }

            // Update enemies
            for (let i = state.enemies.length - 1; i >= 0; i--) {
                const e = state.enemies[i];
                const dx2 = p.x - e.x;
                const dy2 = p.y - e.y;
                const dist2 = Math.sqrt(dx2 * dx2 + dy2 * dy2);

                if (dist2 < e.radius + p.radius + 10) {
                    if (e.attackCooldown <= 0) {
                        state.spark = Math.max(0, state.spark - 5);
                        emitParticles(e.x, e.y, 15, '#ff4444', 4, 20);
                        state.shake = 4;
                        e.attackCooldown = 40;
                        if (state.spark <= 0) {
                            resetGame();
                            return;
                        }
                    }
                } else {
                    const speed = e.speed * (state.mode === 'vehicle' ? 0.7 : 1);
                    e.x += (dx2 / dist2) * speed;
                    e.y += (dy2 / dist2) * speed;
                }

                if (e.attackCooldown > 0) e.attackCooldown--;
                if (e.hitTimer > 0) e.hitTimer--;

                e.x = Math.max(e.radius, Math.min(W - e.radius, e.x));
                e.y = Math.max(e.radius, Math.min(H - e.radius, e.y));

                // Enemy vs buildings
                for (const b of state.buildings) {
                    if (b.destroyed) continue;
                    if (e.x > b.x - b.w / 2 && e.x < b.x + b.w / 2 &&
                        e.y > b.y - b.h / 2 && e.y < b.y + b.h / 2) {
                        b.hp--;
                        if (b.hp <= 0) {
                            b.destroyed = true;
                            state.destroyedBuildings++;
                            emitExplosion(b.x, b.y, 0.8);
                            state.combinerCharge = Math.min(state.maxCombiner, state.combinerCharge + 8);
                        }
                        e.x -= (dx2 / dist2) * 3;
                        e.y -= (dy2 / dist2) * 3;
                    }
                }

                if (e.hp <= 0) {
                    emitExplosion(e.x, e.y, 0.6);
                    state.score += e.type === 'tank' ? 30 : e.type === 'soldier' ? 20 : 10;
                    state.combinerCharge = Math.min(state.maxCombiner, state.combinerCharge + 5);
                    state.spark = Math.min(state.maxSpark, state.spark + 2);
                    state.enemies.splice(i, 1);
                    continue;
                }

                if (dist2 < e.radius + p.radius) {
                    const angle = Math.atan2(dy2, dx2);
                    p.x -= Math.cos(angle) * 1.5;
                    p.y -= Math.sin(angle) * 1.5;
                }
            }

            // Update projectiles
            for (let i = state.projectiles.length - 1; i >= 0; i--) {
                const proj = state.projectiles[i];
                proj.x += proj.vx;
                proj.y += proj.vy;
                proj.life--;

                proj.trail.push({ x: proj.x, y: proj.y, life: 10 });
                if (proj.trail.length > 12) proj.trail.shift();
                for (let t = proj.trail.length - 1; t >= 0; t--) {
                    proj.trail[t].life--;
                    if (proj.trail[t].life <= 0) proj.trail.splice(t, 1);
                }

                let hit = false;
                for (const e of state.enemies) {
                    const d = Math.sqrt((proj.x - e.x) ** 2 + (proj.y - e.y) ** 2);
                    if (d < e.radius + proj.radius) {
                        e.hp -= proj.damage;
                        e.hitTimer = 10;
                        emitParticles(proj.x, proj.y, 12, '#ffcc44', 4, 20);
                        state.comboCount++;
                        state.comboTimer = 60;
                        if (state.comboCount > 5) {
                            showStatus(`🔥 ${state.comboCount}x COMBO`);
                        }
                        hit = true;
                        break;
                    }
                }

                if (!hit) {
                    for (const b of state.buildings) {
                        if (b.destroyed) continue;
                        if (proj.x > b.x - b.w / 2 && proj.x < b.x + b.w / 2 &&
                            proj.y > b.y - b.h / 2 && proj.y < b.y + b.h / 2) {
                            b.hp--;
                            if (b.hp <= 0) {
                                b.destroyed = true;
                                state.destroyedBuildings++;
                                emitExplosion(b.x, b.y, 0.6);
                                state.combinerCharge = Math.min(state.maxCombiner, state.combinerCharge + 5);
                            }
                            hit = true;
                            break;
                        }
                    }
                }

                if (hit || proj.life <= 0 || proj.x < -50 || proj.x > W + 50 || proj.y < -50 || proj.y > H + 50) {
                    if (hit) emitParticles(proj.x, proj.y, 8, '#88ddff', 3, 12);
                    state.projectiles.splice(i, 1);
                }
            }

            // Update particles
            for (let i = state.particles.length - 1; i >= 0; i--) {
                const pt = state.particles[i];
                pt.x += pt.vx;
                pt.y += pt.vy;
                pt.vx *= 0.97;
                pt.vy *= 0.97;
                pt.life--;
                if (pt.life <= 0) {
                    state.particles.splice(i, 1);
                }
            }

            if (state.shake > 0) state.shake *= 0.9;
            if (state.shake < 0.1) state.shake = 0;

            // Update HUD
            sparkValueEl.textContent = Math.round(state.spark) + '%';
            const chargePct = (state.combinerCharge / state.maxCombiner) * 100;
            combinerFill.style.width = chargePct + '%';
            combinerStatus.textContent = Math.round(chargePct) + '% · ' +
                (state.isCombinerReady ? '⚡ READY' : 'CHARGING');
            scoreValueEl.textContent = state.score;

            // Combiner activation
            if (state.isCombinerReady && state.enemies.length > 2) {
                state.isCombinerReady = false;
                state.combinerCharge = 0;
                showStatus('⚡ COMBINER BLAST!');
                for (const e of state.enemies) {
                    emitExplosion(e.x, e.y, 1.2);
                    state.score += 50;
                }
                state.enemies = [];
                state.shake = 20;
                emitExplosion(W / 2, H / 2, 3);
                for (const b of state.buildings) {
                    if (!b.destroyed && Math.random() < 0.3) {
                        b.destroyed = true;
                        state.destroyedBuildings++;
                        emitExplosion(b.x, b.y, 0.5);
                    }
                }
            }

            if (state.spark < 15 && state.mode === 'robot' && state.morphCooldown <= 0) {
                toggleMorph();
            }
        }

        // ============================================================
        //  TOGGLE MORPH
        // ============================================================
        function toggleMorph() {
            if (state.morphCooldown > 0) return;
            state.mode = state.mode === 'robot' ? 'vehicle' : 'robot';
            state.morphCooldown = 20;
            modeNameEl.textContent = state.mode.toUpperCase();
            modeNameEl.className = state.mode;
            modePromptEl.textContent = state.mode === 'robot' ?
                '[ SPACE ] to Morph · [ CLICK ] to Attack' :
                '[ SPACE ] to Morph · [ CLICK ] to Ram';
            showStatus(state.mode === 'robot' ? '🤖 ROBOT MODE' : '🚗 VEHICLE MODE');
            emitParticles(state.player.x, state.player.y, 30, state.mode === 'robot' ? '#4cf' : '#f84', 6, 25);
            state.shake = 3;
        }

        // ============================================================
        //  SHOW STATUS
        // ============================================================
        let statusTimeout = null;

        function showStatus(text) {
            statusMsg.textContent = text;
            statusMsg.classList.add('show');
            if (statusTimeout) clearTimeout(statusTimeout);
            statusTimeout = setTimeout(() => {
                statusMsg.classList.remove('show');
            }, 1000);
        }

        // ============================================================
        //  RESET
        // ============================================================
        function resetGame() {
            state.spark = state.maxSpark;
            state.enemies = [];
            state.projectiles = [];
            state.particles = [];
            state.combinerCharge = 0;
            state.isCombinerReady = false;
            state.score = 0;
            state.comboCount = 0;
            state.destroyedBuildings = 0;
            state.enemySpawnTimer = 60;
            spawnBuildings();
            state.player.x = W / 2;
            state.player.y = H / 2;
            state.player.targetX = W / 2;
            state.player.targetY = H / 2;
            showStatus('⚡ REBOOT');
            emitExplosion(W / 2, H / 2, 2);
        }

        // ============================================================
        //  DRAW
        // ============================================================
        function draw() {
