<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Transformers Cyber Battle</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #050817;
    color: white;
}

canvas {
    display: block;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
}

/* ================= MENU ================= */

#menu {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle at center, #182454 0%, #080d21 45%, #02040b 100%);
}

.menu-box {
    width: 900px;
    max-width: 92%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 30px;
    border: 2px solid #3f527c;
    border-radius: 20px;
    background: rgba(7, 12, 30, 0.96);
    box-shadow:
        0 0 30px rgba(50, 180, 255, 0.15),
        inset 0 0 30px rgba(50, 100, 255, 0.08);
}

.title {
    text-align: center;
    font-size: 48px;
    font-weight: 900;
    color: #ffd83d;
    text-shadow: 0 0 20px rgba(255, 216, 61, 0.35);
}

.subtitle {
    text-align: center;
    color: #9aa9ca;
    margin-bottom: 25px;
}

.characters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
}

.character {
    border: 2px solid #263557;
    border-radius: 12px;
    background: #101831;
    color: white;
    padding: 15px;
    cursor: pointer;
    text-align: left;
    transition: 0.2s;
}

.character:hover {
    transform: translateY(-3px);
    border-color: #4ddfff;
}

.character.selected {
    border-color: #ffd83d;
    box-shadow: 0 0 20px rgba(255, 216, 61, 0.2);
    background: #18213d;
}

.character-color {
    height: 8px;
    border-radius: 8px;
    margin-bottom: 12px;
}

.character-name {
    font-size: 17px;
    font-weight: bold;
}

.character-role {
    color: #8f9fbe;
    font-size: 12px;
    margin-top: 5px;
}

.start {
    width: 100%;
    border: 0;
    border-radius: 12px;
    padding: 16px;
    margin-top: 20px;
    background: #ffd83d;
    color: #111;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
}

.start:hover {
    background: #ffe878;
}

/* ================= HUD ================= */

#hud {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    display: none;
}

.panel {
    background: rgba(5, 10, 27, 0.9);
    border: 1px solid #30405f;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.35);
}

#stats {
    position: absolute;
    left: 15px;
    top: 15px;
    width: 280px;
    padding: 15px;
}

.game-title {
    font-weight: bold;
    color: #ffd83d;
    margin-bottom: 10px;
}

.label {
    font-size: 11px;
    color: #9caccc;
    margin-top: 5px;
}

.bar {
    height: 12px;
    background: #1a2035;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 5px;
    margin-bottom: 8px;
}

.hp-bar {
    height: 100%;
    background: linear-gradient(90deg, #db3048, #ff6a76);
}

.energy-bar {
    height: 100%;
    background: linear-gradient(90deg, #1dafff, #61efff);
}

#mode-box {
    position: absolute;
    right: 15px;
    top: 15px;
    padding: 15px;
    text-align: right;
}

#mode {
    font-size: 28px;
    font-weight: bold;
    color: #59eaff;
}

#message {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 32px;
    font-weight: bold;
    color: #ffd83d;
    text-shadow: 0 0 15px black;
    opacity: 0;
}

#help {
    position: absolute;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    padding: 10px 16px;
    color: #aab8d4;
    font-size: 12px;
    white-space: nowrap;
}

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 30px;
    transform: translate(-50%, -50%);
}

#crosshair::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 0;
    width: 2px;
    height: 30px;
    background: white;
}

#crosshair::after {
    content: "";
    position: absolute;
    left: 0;
    top: 14px;
    width: 30px;
    height: 2px;
    background: white;
}

/* ================= GAME OVER ================= */

#gameover {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.82);
}

.gameover-box {
    padding: 35px;
    text-align: center;
}

.gameover-box h1 {
    color: #ff5264;
}

.restart {
    border: 0;
    background: #ffd83d;
    padding: 13px 25px;
    border-radius: 10px;
    font-weight: bold;
    cursor: pointer;
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<!-- ================= MENU ================= -->

<div id="menu">
    <div class="menu-box">

        <div class="title">CYBER BATTLE</div>

        <div class="subtitle">
            Choose your Autobot
        </div>

        <div class="characters" id="characters"></div>

        <button class="start" onclick="startGame()">
            START BATTLE
        </button>

    </div>
</div>

<!-- ================= HUD ================= -->

<div id="hud">

    <div id="stats" class="panel">

        <div class="game-title">
            TRANSFORMERS: CYBER BATTLE
        </div>

        <div class="label">HEALTH</div>

        <div class="bar">
            <div id="hpBar" class="hp-bar"></div>
        </div>

        <div class="label">ENERGY</div>

        <div class="bar">
            <div id="energyBar" class="energy-bar"></div>
        </div>

        <div id="numbers">
            Score: 0<br>
            XP: 0<br>
            Wave: 1
        </div>

    </div>

    <div id="mode-box" class="panel">

        <div class="label">
            FORM
        </div>

        <div id="mode">
            ROBOT
        </div>

        <div id="characterName">
            Optimus
        </div>

    </div>

    <div id="crosshair"></div>

    <div id="message">
        TRANSFORM!
    </div>

    <div id="help" class="panel">
        WASD / ARROWS = Move &nbsp; | &nbsp;
        MOUSE = Aim &nbsp; | &nbsp;
        CLICK / SPACE = Shoot &nbsp; | &nbsp;
        T = Transform &nbsp; | &nbsp;
        R = Respawn
    </div>

</div>

<!-- ================= GAME OVER ================= -->

<div id="gameover">

    <div class="gameover-box panel">

        <h1>MISSION FAILED</h1>

        <p id="finalScore"></p>

        <button class="restart" onclick="respawn()">
            RESPAWN
        </button>

    </div>

</div>

<script>

/* =========================================================
   CANVAS
========================================================= */

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let width = window.innerWidth;
let height = window.innerHeight;

function resize() {

    width = window.innerWidth;
    height = window.innerHeight;

    canvas.width = width;
    canvas.height = height;
}

window.addEventListener("resize", resize);

resize();

/* =========================================================
   CHARACTERS
========================================================= */

const characters = [

    {
        name: "Optimus",
        role: "Leader",
        color: "#d72d3e",
        accent: "#2673b5",
        hp: 160,
        damage: 28,
        speed: 3
    },

    {
        name: "Bumblebee",
        role: "Scout",
        color: "#f4c52f",
        accent: "#202633",
        hp: 110,
        damage: 20,
        speed: 4
    },

    {
        name: "Grimlock",
        role: "Dino",
        color: "#747f8e",
        accent: "#d3a92e",
        hp: 200,
        damage: 34,
        speed: 2.3
    },

    {
        name: "Mirage",
        role: "Speedster",
        color: "#45c6df",
        accent: "#eef4f5",
        hp: 115,
        damage: 22,
        speed: 4.2
    },

    {
        name: "Arcee",
        role: "Warrior",
        color: "#d86a9a",
        accent: "#e0ebef",
        hp: 125,
        damage: 24,
        speed: 3.5
    },

    {
        name: "Jazz",
        role: "Specialist",
        color: "#e7eef0",
        accent: "#556ad1",
        hp: 125,
        damage: 26,
        speed: 3.4
    },

    {
        name: "Ratchet",
        role: "Medic",
        color: "#e4e5db",
        accent: "#ce3b43",
        hp: 155,
        damage: 21,
        speed: 2.8
    },

    {
        name: "Wheeljack",
        role: "Engineer",
        color: "#e8eeea",
        accent: "#43805d",
        hp: 140,
        damage: 27,
        speed: 3.1
    },

    {
        name: "Hot Rod",
        role: "Hothead",
        color: "#8148c5",
        accent: "#ecc633",
        hp: 130,
        damage: 30,
        speed: 3.7
    },

    {
        name: "Ultra Magnus",
        role: "Commander",
        color: "#dbe3ec",
        accent: "#315ba7",
        hp: 185,
        damage: 32,
        speed: 2.7
    }

];

let selectedCharacter = 0;

/* CREATE CHARACTER BUTTONS */

const characterContainer =
    document.getElementById("characters");

characters.forEach((character, index) => {

    const button = document.createElement("button");

    button.className = "character";

    button.innerHTML = `

        <div
            class="character-color"
            style="
                background:
                linear-gradient(
                    90deg,
                    ${character.color},
                    ${character.accent}
                )
            "
        ></div>

        <div class="character-name">
            ${index === 9 ? "0" : index + 1} —
            ${character.name}
        </div>

        <div class="character-role">
            ${character.role}
            <br>
            HP ${character.hp}
            • DMG ${character.damage}
            • SPD ${character.speed}
        </div>

    `;

    button.onclick = () => {

        selectedCharacter = index;

        document
            .querySelectorAll(".character")
            .forEach((element, i) => {

                element.classList.toggle(
                    "selected",
                    i === index
                );

            });

    };

    characterContainer.appendChild(button);

});

/* SELECT FIRST */

document
    .querySelectorAll(".character")[0]
    .classList.add("selected");

/* =========================================================
   GAME STATE
========================================================= */

let player;

let enemies = [];

let bullets = [];

let particles = [];

let score = 0;

let xp = 0;

let wave = 1;

let gameRunning = false;

let gameOver = false;

let spawnTimer = 0;

let fireCooldown = 0;

/* =========================================================
   INPUT
========================================================= */

const keys = {};

let mouseX = width / 2;

let mouseY = height / 2;

let mouseDown = false;

window.addEventListener("keydown", event => {

    keys[event.key.toLowerCase()] = true;

    if (event.key.toLowerCase() === "t") {

        transform();

    }

    if (event.key.toLowerCase() === "r") {

        respawn();

    }

});

window.addEventListener("keyup", event => {

    keys[event.key.toLowerCase()] = false;

});

window.addEventListener("mousemove", event => {

    mouseX = event.clientX;

    mouseY = event.clientY;

});

window.addEventListener("mousedown", () => {

    mouseDown = true;

});

window.addEventListener("mouseup", () => {

    mouseDown = false;

});

/* =========================================================
   START GAME
========================================================= */

function startGame() {

    document.getElementById("menu").style.display = "none";

    document.getElementById("hud").style.display = "block";

    gameRunning = true;

    respawn();

}

/* =========================================================
   RESPAWN
========================================================= */

function respawn() {

    const character = characters[selectedCharacter];

    player = {

        x: 0,

        y: 0,

        angle: 0,

        health: character.hp,

        maxHealth: character.hp,

        energy: 100,

        mode: "robot",

        speed: character.speed,

        damage: character.damage,

        character: character

    };

    enemies = [];

    bullets = [];

    particles = [];

    score = 0;

    xp = 0;

    wave = 1;

    spawnTimer = 0;

    gameOver = false;

    document.getElementById("gameover").style.display = "none";

    for (let i = 0; i < 6; i++) {

        spawnEnemy();

    }

}

/* =========================================================
   TRANSFORMATION
========================================================= */

function transform() {

    if (!player || gameOver) return;

    if (player.energy < 15) return;

    player.energy -= 15;

    if (player.mode === "robot") {

        player.mode = "vehicle";

        player.speed = player.character.speed * 1.5;

        showMessage("VEHICLE MODE");

    }

    else if (player.mode === "vehicle") {

        player.mode = "jet";

        player.speed = player.character.speed * 2;

        showMessage("JET MODE");

    }

    else {

        player.mode = "robot";

        player.speed = player.character.speed;

        showMessage("ROBOT MODE");

    }

}

/* =========================================================
   MESSAGE
========================================================= */

let messageTimeout;

function showMessage(text) {

    const message =
        document.getElementById("message");

    message.innerText = text;

    message.style.opacity = "1";

    clearTimeout(messageTimeout);

    messageTimeout = setTimeout(() => {

        message.style.opacity = "0";

    }, 700);

}

/* =========================================================
   ENEMIES
========================================================= */

function spawnEnemy() {

    const distance = 12 + Math.random() * 12;

    const angle = Math.random() * Math.PI * 2;

    const type = Math.random();

    let enemy;

    if (type < 0.7) {

        enemy = {

            x: Math.cos(angle) * distance,

            y: Math.sin(angle) * distance,

            health: 50 + wave * 5,

            speed: 1.5,

            damage: 8

        };

    }

    else if (type < 0.9) {

        enemy = {

            x: Math.cos(angle) * distance,

            y: Math.sin(angle) * distance,

            health: 70 + wave * 7,

            speed: 2,

            damage: 11

        };

    }

    else {

        enemy = {

            x: Math.cos(angle) * distance,

            y: Math.sin(angle) * distance,

            health: 110 + wave * 8,

            speed: 1,

            damage: 18

        };

    }

    enemy.maxHealth = enemy.health;

    enemies.push(enemy);

}

/* =========================================================
   SHOOTING
========================================================= */

function shoot() {

    if (!player || gameOver) return;

    if (player.energy < 4) return;

    if (fireCooldown > 0) return;

    player.energy -= 4;

    fireCooldown =
        player.mode === "jet"
        ? 5
        : 9;

    const angle = player.angle;

    bullets.push({

        x: player.x,

        y: player.y,

        vx: Math.cos(angle) * 16,

        vy: Math.sin(angle) * 16,

        damage:
            player.damage *
            (player.mode === "jet" ? 1.25 : 1),

        life: 100,

        playerBullet: true

    });

}

/* =========================================================
   UPDATE
========================================================= */

function update() {

    if (!gameRunning || gameOver) return;

    const dt = 1 / 60;

    /* MOVEMENT */

    let dx = 0;
    let dy = 0;

    if (
        keys["w"] ||
        keys["arrowup"]
    ) dy -= 1;

    if (
        keys["s"] ||
        keys["arrowdown"]
    ) dy += 1;

    if (
        keys["a"] ||
        keys["arrowleft"]
    ) dx -= 1;

    if (
        keys["d"] ||
        keys["arrowright"]
    ) dx += 1;

    if (dx !== 0 || dy !== 0) {

        const length =
            Math.sqrt(dx * dx + dy * dy);

        player.x +=
            dx / length *
            player.speed *
            dt *
            4;

        player.y +=
            dy / length *
            player.speed *
            dt *
            4;

    }

    /* AIM */

    player.angle =
        Math.atan2(
            mouseY - height / 2,
            mouseX - width / 2
        );

    /* SHOOT */

    fireCooldown =
        Math.max(0, fireCooldown - 1);

    if (
        mouseDown ||
        keys[" "]
    ) {

        shoot();

    }

    /* ENERGY */

    player.energy =
        Math.min(
            100,
            player.energy + 0.05
        );

    /* SPAWN */

    spawnTimer--;

    if (spawnTimer <= 0) {

        spawnTimer =
            Math.max(20, 90 - wave * 5);

        if (enemies.length < 5 + wave) {

            spawnEnemy();

        }

    }

    /* WAVE */

    if (
        score >=
        wave * 500
    ) {

        wave++;

        showMessage(
            "WAVE " + wave
        );

    }

    /* ENEMIES */

    enemies.forEach(enemy => {

        const dx =
            player.x - enemy.x;

        const dy =
            player.y - enemy.y;

        const distance =
            Math.sqrt(
                dx * dx +
                dy * dy
            );

        if (distance > 1.5) {

            enemy.x +=
                dx / distance *
                enemy.speed *
                dt *
                4;

            enemy.y +=
                dy / distance *
                enemy.speed *
                dt *
                4;

        }

        if (distance < 1.6) {

            player.health -=
                enemy.damage * dt;

        }

    });

    /* BULLETS */

    bullets.forEach(bullet => {

        bullet.x +=
            bullet.vx * dt;

        bullet.y +=
            bullet.vy * dt;

        bullet.life--;

    });

    /* COLLISIONS */

    bullets.forEach(bullet => {

        enemies.forEach(enemy => {

            const dx =
                bullet.x -
                enemy.x;

            const dy =
                bullet.y -
                enemy.y;

            const distance =
                Math.sqrt(
                    dx * dx +
                    dy * dy
                );

            if (
                distance < 1.2 &&
                bullet.playerBullet
            ) {

                enemy.health -=
                    bullet.damage;

                bullet.life = 0;

                createExplosion(
                    enemy.x,
                    enemy.y
                );

                if (enemy.health <= 0) {

                    score += 100;

                    xp += 10;

                    createExplosion(
                        enemy.x,
                        enemy.y,
                        20
                    );

                }

            }

        });

    });

    /* REMOVE DEAD */

    enemies =
        enemies.filter(
            enemy => enemy.health > 0
        );

    bullets =
        bullets.filter(
            bullet => bullet.life > 0
        );

    /* PARTICLES */

    particles.forEach(particle => {

        particle.x += particle.vx;

        particle.y += particle.vy;

        particle.life--;

    });

    particles =
        particles.filter(
            particle => particle.life > 0
        );

    /* GAME OVER */

    if (player.health <= 0) {

        player.health = 0;

        gameOver = true;

        document.getElementById(
            "gameover"
        ).style.display = "flex";

        document.getElementById(
            "finalScore"
        ).innerText =
            "Score: " +
            score +
            " | Wave: " +
            wave +
            " | XP: " +
            xp;

    }

}

/* =========================================================
   EXPLOSIONS
========================================================= */

function createExplosion(
    x,
    y,
    amount = 7
) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        const angle =
            Math.random() *
            Math.PI * 2;

        const speed =
            Math.random() * 0.15;

        particles.push({

            x: x,

            y: y,

            vx: Math.cos(angle) * speed,

            vy: Math.sin(angle) * speed,

            life:
                20 +
                Math.random() * 25

        });

    }

}

/* =========================================================
   DRAW
========================================================= */

function draw() {

    /* BACKGROUND */

    ctx.fillStyle = "#060a18";

    ctx.fillRect(
        0,
        0,
        width,
        height
    );

    /* GRID */

    drawGrid();

    if (!player) return;

    /* ENEMIES */

    enemies.forEach(
        drawEnemy
    );

    /* BULLETS */

    bullets.forEach(
        drawBullet
    );

    /* PARTICLES */

    particles.forEach(
        drawParticle
    );

    /* PLAYER */

    drawPlayer();

}

/* =========================================================
   GRID
========================================================= */

function drawGrid() {

    const grid = 60;

    ctx.strokeStyle =
        "rgba(40,80,130,0.18)";

    ctx.lineWidth = 1;

    const offsetX =
        width / 2 -
        player.x * grid;

    const offsetY =
        height / 2 -
        player.y * grid;

    for (
        let x = offsetX % grid;
        x < width;
        x += grid
    ) {

        ctx.beginPath();

        ctx.moveTo(x, 0);

        ctx.lineTo(x, height);

        ctx.stroke();

    }

    for (
        let x = offsetX % grid;
        x > 0;
        x -= grid
    ) {

        ctx.beginPath();

        ctx.moveTo(x, 0);

        ctx.lineTo(x, height);

        ctx.stroke();

    }

    for (
        let y = offsetY % grid;
        y < height;
        y += grid
    ) {

        ctx.beginPath();

        ctx.moveTo(0, y);

        ctx.lineTo(width, y);

        ctx.stroke();

    }

    for (
        let y = offsetY % grid;
        y > 0;
        y -= grid
    ) {

        ctx.beginPath();

        ctx.moveTo(0, y);

        ctx.lineTo(width, y);

        ctx.stroke();

    }

}

/* =========================================================
   WORLD POSITION
========================================================= */

function screenPosition(x, y) {

    const scale = 55;

    return {

        x:
            width / 2 +
            (x - player.x) *
            scale,

        y:
            height / 2 +
            (y - player.y) *
            scale

    };

}

/* =========================================================
   DRAW PLAYER
========================================================= */

function drawPlayer() {

    const pos =
        screenPosition(
            player.x,
            player.y
        );

    ctx.save();

    ctx.translate(
        pos.x,
        pos.y
    );

    ctx.rotate(
        player.angle
    );

    if (
        player.mode ===
        "robot"
    ) {

        drawRobot(
            player.character
        );

    }

    else if (
        player.mode ===
        "vehicle"
    ) {

        drawVehicle(
            player.character
        );

    }

    else {

        drawJet(
            player.character
        );

    }

    ctx.restore();

}

/* =========================================================
   ROBOT
========================================================= */

function drawRobot(character) {

    /* glow */

    ctx.shadowBlur = 20;

    ctx.shadowColor =
        character.accent;

    /* legs */

    ctx.fillStyle =
        character.accent;

    ctx.fillRect(
        -18,
        15,
        12,
        28
    );

    ctx.fillRect(
        6,
        15,
        12,
        28
    );

    /* feet */

    ctx.fillRect(
        -23,
        37,
        17,
        7
    );

    ctx.fillRect(
        6,
        37,
        17,
        7
    );

    /* body */

    ctx.fillStyle =
        character.color;

    roundRect(
        -26,
        -20,
        52,
        42,
        7
    );

    /* chest */

    ctx.fillStyle =
        character.accent;

    roundRect(
        -18,
        -10,
        36,
        18,
        4
    );

    /* arms */

    ctx.fillStyle =
        character.color;

    ctx.fillRect(
        -39,
        -14,
        12,
        34
    );

    ctx.fillRect(
        27,
        -14,
        12,
        34
    );

    /* head */

    ctx.fillStyle =
        character.color;

    roundRect(
        -18,
        -42,
        36,
        23,
        6
    );

    /* visor */

    ctx.fillStyle =
        "#61eaff";

    ctx.fillRect(
        -11,
        -34,
        22,
        5
    );

    /* center emblem */

    ctx.fillStyle =
        "#ffffff";

    ctx.beginPath();

    ctx.moveTo(0, -5);
    ctx.lineTo(6, 2);
    ctx.lineTo(0, 7);
    ctx.lineTo(-6, 2);
    ctx.closePath();

    ctx.fill();

    ctx.shadowBlur = 0;

}

/* =========================================================
   VEHICLE
========================================================= */

function drawVehicle(character) {

    ctx.shadowBlur = 20;

    ctx.shadowColor =
        character.accent;

    /* body */

    ctx.fillStyle =
        character.color;

    roundRect(
        -48,
        -20,
        96,
        40,
        10
    );

    /* windows */

    ctx.fillStyle =
        "#18253a";

    ctx.fillRect(
        -15,
        -15,
        35,
        12
    );

    /* front */

    ctx.fillStyle =
        character.accent;

    ctx.fillRect(
        30,
        -10,
        18,
        20
    );

    /* wheels */

    ctx.fillStyle =
        "#090d17";

    circle(
        -27,
        -22,
        10
    );

    circle(
        27,
        -22,
        10
    );

    circle(
        -27,
        22,
        10
    );

    circle(
        27,
        22,
        10
    );

    ctx.shadowBlur = 0;

}

/* =========================================================
   JET
========================================================= */

function drawJet(character) {

    ctx.shadowBlur = 25;

    ctx.shadowColor =
        "#52eaff";

    /* wings */

    ctx.fillStyle =
        character.accent;

    ctx.beginPath();

    ctx.moveTo(45, 0);
    ctx.lineTo(-25, -35);
    ctx.lineTo(-10, 0);
    ctx.lineTo(-25, 35);

    ctx.closePath();

    ctx.fill();

    /* body */

    ctx.fillStyle =
        character.color;

    ctx.beginPath();

    ctx.moveTo(55, 0);
    ctx.lineTo(-20, -12);
    ctx.lineTo(-30, 0);
    ctx.lineTo(-20, 12);

    ctx.closePath();

    ctx.fill();

    /* engine */

    ctx.fillStyle =
        "#65eaff";

    circle(
        -15,
        0,
        6
    );

    ctx.shadowBlur = 0;

}

/* =========================================================
   ENEMY
========================================================= */

function drawEnemy(enemy) {

    const pos =
        screenPosition(
            enemy.x,
            enemy.y
        );

    ctx.save();

    ctx.translate(
        pos.x,
        pos.y
    );

    ctx.fillStyle =
        "#8d374d";

    /* body */

    ctx.fillRect(
        -18,
        -15,
        36,
        32
    );

    /* head */

    ctx.fillStyle =
        "#ae4458";

    ctx.fillRect(
        -13,
        -30,
        26,
        16
    );

    /* eyes */

    ctx.fillStyle =
        "#ff475e";

    ctx.fillRect(
        -8,
        -25,
        6,
        3
    );

    ctx.fillRect(
        2,
        -25,
        6,
        3
    );

    /* arms */

    ctx.fillStyle =
        "#5c2940";

    ctx.fillRect(
        -29,
        -12,
        10,
        25
    );

    ctx.fillRect(
        19,
        -12,
        10,
        25
    );

    /* health bar */

    ctx.fillStyle =
        "#1c2031";

    ctx.fillRect(
        -25,
        -38,
        50,
        5
    );

    ctx.fillStyle =
        "#ff465d";

    ctx.fillRect(
        -25,
        -38,
        50 *
        Math.max(
            0,
            enemy.health /
            enemy.maxHealth
        ),
        5
    );

    ctx.restore();

}

/* =========================================================
   BULLET
========================================================= */

function drawBullet(bullet) {

    const pos =
        screenPosition(
            bullet.x,
            bullet.y
        );

    ctx.fillStyle =
        "#63eaff";

    ctx.shadowBlur = 15;

    ctx.shadowColor =
        "#63eaff";

    ctx.beginPath();

    ctx.arc(
        pos.x,
        pos.y,
        5,
        0,
        Math.PI * 2
    );

    ctx.fill();

    ctx.shadowBlur = 0;

}

/* =========================================================
   PARTICLE
========================================================= */

function drawParticle(particle) {

    const pos =
        screenPosition(
            particle.x,
            particle.y
        );

    ctx.fillStyle =
        "#ffbd4a";

    ctx.beginPath();

    ctx.arc(
        pos.x,
        pos.y,
        3,
        0,
        Math.PI * 2
    );

    ctx.fill();

}

/* =========================================================
   HELPERS
========================================================= */

function roundRect(
    x,
    y,
    width,
    height,
    radius
) {

    ctx.beginPath();

    ctx.roundRect(
        x,
        y,
        width,
        height,
        radius
    );

    ctx.fill();

}

function circle(
    x,
    y,
    radius
) {

    ctx.beginPath();

    ctx.arc(
        x,
        y,
        radius,
        0,
        Math.PI * 2
    );

    ctx.fill();

}

/* =========================================================
   HUD
========================================================= */

function updateHUD() {

    if (!player) return;

    document.getElementById(
        "hpBar"
    ).style.width =
        (
            player.health /
            player.maxHealth *
            100
        ) + "%";

    document.getElementById(
        "energyBar"
    ).style.width =
        player.energy + "%";

    document.getElementById(
        "numbers"
    ).innerHTML =

        "Score: " +
        score +

        "<br>XP: " +
        xp +

        "<br>Wave: " +
        wave;

    document.getElementById(
        "mode"
    ).innerText =
        player.mode.toUpperCase();

    document.getElementById(
        "characterName"
    ).innerText =
        player.character.name;

}

/* =========================================================
   GAME LOOP
========================================================= */

function gameLoop() {

    update();

    draw();

    updateHUD();

    requestAnimationFrame(
        gameLoop
    );

}

gameLoop();

</script>

</body>
</html>
